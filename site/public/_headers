# Cloudflare static-asset headers (Workers assets read this file from the build output).
# Share cards: each page links its card with ?v=<hash>, so a changed card gets a new URL;
# a day's cache keeps the plain URL fresh enough for anyone who links it without ?v.
/og/*
  Cache-Control: public, max-age=86400
  Access-Control-Allow-Origin: *
/site.webmanifest
  Content-Type: application/manifest+json
